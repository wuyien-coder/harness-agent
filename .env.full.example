# Full stack template. Replace paths and credentials locally; never commit .env.
MATHKB_DATABASE_URL=postgresql+psycopg://mathkb:replace-password@127.0.0.1:15432/mathkb
MATHKB_CREATE_SCHEMA=false
MATHKB_DATA_DIR=./data/full
MATHKB_BIOGRAPHIES_DIR=./data/full/biographies
MATHKB_INDEX_DIR=./.index/full
MATHKB_VECTOR__PROVIDER=pgvector
MATHKB_VECTOR__COLLECTION=mathkb_full
MATHKB_KEYWORD__PERSIST_DIR=./.index/full/bm25
MATHKB_EMBEDDING__PROVIDER=bge
MATHKB_EMBEDDING__CACHE_DIR=./models
MATHKB_EMBEDDING__VECTOR_CACHE_DIR=./.index/embedding-cache
MATHKB_RERANK__ENABLED=false
MATHKB_QUEUE__PROVIDER=celery
MATHKB_QUEUE__REDIS_URL=redis://127.0.0.1:16379/0
MATHKB_CACHE__ENABLED=true
MATHKB_CACHE__REDIS_URL=redis://127.0.0.1:16379/1
MATHKB_LLM__PROVIDER=openai
MATHKB_LLM__BASE_URL=https://api.deepseek.com/v1
MATHKB_LLM__MODEL=deepseek-chat
MATHKB_LLM_CONFIG_FILE=./.runtime/private.env
MATHKB_SERVER__HOST=127.0.0.1
MATHKB_SERVER__PORT=8001
MATHKB_SERVER__API_TOKEN=
MODEL_CACHE_DIR=./models

MATHKB_AGENT__MAX_STEPS=4
MATHKB_AGENT__MAX_EVIDENCE=12
MATHKB_AGENT__MAX_OBSERVATION_CHARS=6000
